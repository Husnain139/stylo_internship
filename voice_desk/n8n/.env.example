# Copy to .env next to docker-compose.yml. Do not commit .env.

# n8n UI / editor (local)
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Karachi

# Required so Code nodes can read DESK_SECRET / GINKGO_* / SHEET_ID via $env
# (n8n UI "Variables" is not needed for community / demo)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Public origin ElevenLabs will call (no path). Set AFTER cloudflared prints the URL.
# Prefer N8N_WEBHOOK_URL (WEBHOOK_URL is deprecated).
# Example: https://random-words.trycloudflare.com/
N8N_WEBHOOK_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/

# Desk secrets — same names the workflow Code nodes read via $env
DESK_SECRET=replace-with-a-long-random-string
GINKGO_BASE_URL=https://the-order-inquiry-endpoint
GINKGO_AUTH=the-authorization-header-value
SHEET_ID=spreadsheet-id-from-the-google-sheet-url
