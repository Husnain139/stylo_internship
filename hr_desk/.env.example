# Copy to hr_desk/.env. Never commit the real key.
OPENAI_API_KEY=

# Postgres from docker-compose.yml. Leave unset and set HR_DESK_STORE=memory
# to run without Docker.
DATABASE_URL=postgresql://hr_desk:hr_desk@localhost:5433/hr_desk
HR_DESK_STORE=postgres

# Optional overrides. Defaults keep cost down.
# HR_DESK_MODEL_NANO=gpt-5-nano
# HR_DESK_MODEL_MINI=gpt-5-mini
# HR_DESK_EMBED_MODEL=text-embedding-3-small
