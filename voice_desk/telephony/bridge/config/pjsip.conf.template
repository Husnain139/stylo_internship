; Render with ../render-config.sh after filling ../.env
; LAN PBX peer + ElevenLabs TLS trunk

[transport-lan-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[transport-lan-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060

[transport-el-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
; external_signaling_address=__BRIDGE_IP__
method=tlsv1_2

; ---- Issabel / Elastix (LAN only) ----
[pbx]
type=endpoint
context=from-pbx
disallow=all
allow=ulaw,alaw
transport=transport-lan-__LAN_TRANSPORT__
aors=pbx
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[pbx]
type=identify
endpoint=pbx
match=__PBX_IP__

[pbx]
type=aor
contact=sip:__PBX_IP__:__PBX_PORT__
qualify_frequency=60

; ---- ElevenLabs (outbound from bridge only) ----
[elevenlabs]
type=auth
auth_type=userpass
username=__EL_SIP_USER__
password=__EL_SIP_PASS__

[elevenlabs]
type=aor
contact=sip:__EL_SIP_HOST__:__EL_SIP_PORT__;transport=__EL_SIP_TRANSPORT__
qualify_frequency=0

[elevenlabs]
type=endpoint
context=from-elevenlabs
disallow=all
allow=ulaw,alaw
outbound_auth=elevenlabs
aors=elevenlabs
transport=transport-el-tls
media_encryption=sdes
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_domain=__EL_SIP_HOST__
