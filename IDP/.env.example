OPENAI_API_KEY=

# Model: gpt-4o-mini — strong structure analysis at low token cost
IDP_OPENAI_MODEL=gpt-4o-mini
IDP_OPENAI_MAX_OUTPUT_TOKENS=1024
IDP_OPENAI_MAX_INPUT_CHARS=4000
IDP_OPENAI_MAX_SAMPLE_ROWS=15
IDP_OPENAI_TEMPERATURE=0
IDP_OPENAI_TIMEOUT_SECONDS=30

# Large-file handling (streamed to disk; default 10 GiB)
IDP_MAX_UPLOAD_BYTES=10737418240
IDP_MAX_NON_TABULAR_BYTES=104857600
IDP_SAMPLE_ROWS=8

# DuckDB — leave unset to auto-size from PC RAM/CPU; set to override
# IDP_DUCKDB_MEMORY_GB=8
# IDP_DUCKDB_THREADS=4
IDP_XLSX_MAX_ROWS=200000
# IDP_TEMP_DIR=

# Optional overrides
# IDP_DATA_DIR=
# IDP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000