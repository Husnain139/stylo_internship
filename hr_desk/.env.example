# Copy to hr_desk/.env and set the OpenAI project key. Never commit the key.
OPENAI_API_KEY=

# The local launcher sets the loopback origin, database and data path.
# Set these for an IT-managed company deployment.
# HR_DESK_PUBLIC_ORIGIN=https://hr-desk.company.internal
# HR_DESK_DATA_ROOT=C:/hr-desk-data
# DATABASE_URL=postgresql://hr_desk_app:REPLACE_ME@127.0.0.1:5432/hr_desk
# HR_DESK_EMPLOYEE_DOMAIN=company.example.com
# HR_DESK_SMTP_HOST=smtp.company.internal
# HR_DESK_SMTP_PORT=587
# HR_DESK_SMTP_FROM=hr-desk@company.example.com
# HR_DESK_SMTP_USER=
# HR_DESK_SMTP_PASSWORD=

# Optional account for the live policy evaluation.
# HR_DESK_EVAL_EMPLOYEE_EMAIL=

# Defaults. Review before changing models or sending pictures to OpenAI.
# HR_DESK_MODEL_NANO=gpt-5-nano
# HR_DESK_MODEL_MINI=gpt-5-mini
# HR_DESK_EMBED_MODEL=text-embedding-3-small
# HR_DESK_VISION=0
# TESSDATA_PREFIX=C:/Tesseract-OCR/tessdata
