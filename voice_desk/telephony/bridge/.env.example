# Copy to .env on the bridge VM. Do not commit .env.

# LAN
BRIDGE_IP=192.168.1.50
PBX_IP=192.168.1.10
PBX_PORT=5060
LAN_TRANSPORT=udp

# Inbound DID pattern matched in dialplan (Asterisk pattern or literal)
AI_DID_PATTERN=_X.

# Human fallback extension on the PBX when ElevenLabs fails
FALLBACK_EXT=1000

# ElevenLabs SIP trunk (from ElevenLabs UI — digest)
EL_SIP_USER=replace-me
EL_SIP_PASS=replace-me
EL_SIP_HOST=sip.rtc.elevenlabs.io
EL_SIP_PORT=5061
EL_SIP_TRANSPORT=tls

# Destination identity / number assigned to the Stylo agent in ElevenLabs
# Often an E.164 like +92... or the trunk identifier ElevenLabs shows
EL_DEST=+920000000000

# RTP
RTP_START=10000
RTP_END=10100
